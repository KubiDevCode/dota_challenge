{
  "name": "@aegis-trials/api",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "npm exec -- prisma generate --config ../../prisma.config.ts",
    "dev": "node --watch --require ts-node/register src/main.ts",
    "prebuild": "npm exec -- prisma generate --config ../../prisma.config.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@aegis-trials/shared": "0.0.1",
    "@nestjs/common": "^11.2.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "connect-redis": "^10.0.0",
    "express-session": "^1.19.0",
    "openid": "^2.0.18",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express-session": "^1.19.0",
    "@types/openid": "^2.0.5"
  }
}
