# Copy to .env and set DATABASE_URL before starting the API or running migrations.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
APP_URL=http://localhost:5173

# Local PostgreSQL 16 example only; choose credentials for your environment.
DATABASE_URL=postgresql://aegis:local_password@localhost:5432/aegis_trials
# Redis is required by the API for server-side sessions.
REDIS_URL=redis://localhost:6379
STEAM_API_KEY=
STEAM_REALM=http://localhost:3000/api/auth/steam
STEAM_RETURN_URL=http://localhost:3000/api/auth/steam/callback
STRATZ_API_TOKEN=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_COOKIE_NAME=aegis.sid
SESSION_COOKIE_PATH=/
# Optional: SESSION_COOKIE_DOMAIN=.example.com
SESSION_MAX_AGE_MS=604800000

# Only VITE_-prefixed variables are exposed to the browser. Never put secrets there.
